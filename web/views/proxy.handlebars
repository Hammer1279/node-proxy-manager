<style>
    .text-yellow {
        color: var(--bs-yellow); /* Using Bootstrap's yellow variable */
    }
</style>

<h1 class="text-center">Proxies</h1>
<p>Note: Stubs take precedence over Proxies. If a Stub is configured and enabled for a domain, the Proxy will not be used.</p>
<div class="row">
    <div class="col">
    <a href="/proxy/new" class="btn btn-primary">New Proxy</a>
    <a href="#" onclick="applyConfig(event)" class="btn btn-info">Apply Config</a>
    <p class="spacer"></p>
    {{#each proxies}}
        <div class="card">
            <div class="card-body">
                {{#unless write_protected}}
                    <a href="/proxy/{{id}}/toggle" title="Toggle Enabled" style="text-decoration:none;">
                        {{#if enabled}}
                            <i class="fas fa-check-circle mr-1 text-success" title="Enabled"></i>
                        {{else}}
                            <i class="fas fa-circle-xmark mr-1 text-danger" title="Disabled"></i>
                        {{/if}}
                    </a>
                {{else}}
                    {{#if enabled}}
                        <i class="fas fa-check-circle mr-1 text-success" title="Enabled"></i>
                    {{else}}
                        <i class="fas fa-circle-xmark mr-1 text-danger" title="Disabled"></i>
                    {{/if}}
                {{/unless}}
                {{#if write_protected}}
                    <a href="/proxy/{{id}}/toggle/protection" class="text-danger" title="Write Protected (click to unlock)" style="text-decoration:none;">
                        <i class="fa fa-lock mr-1"></i>
                    </a>
                {{else}}
                    <a href="/proxy/{{id}}/toggle/protection" class="text-success" title="Not Protected (click to lock)" style="text-decoration:none;">
                        <i class="fa fa-unlock mr-1"></i>
                    </a>
                {{/if}}
                {{#if special}}<i class="fa fa-star mr-1 text-warning" title="System Rule"></i>{{/if}}
                <h5 class="card-title">
                    {{#each host}}
                        <a href="http{{#if ../secure}}s{{/if}}://{{this}}" target="_blank">{{this}}</a>{{#unless @last}}, {{/unless}}
                    {{/each}}
                </h5>
                <p class="card-text">
                Enabled: {{#if enabled}}<i class="fa-solid fa-square-check text-success"></i>{{else}}<i class="fa-solid fa-square-xmark text-danger"></i>{{/if}}<br>
                Maintenance: {{#if maintenance}}<i class="fa-solid fa-square-check text-yellow"></i>{{else}}<i class="fa-solid fa-square-xmark text-success"></i>{{/if}}<br>
                Anubis Protected: 
                {{#if anubis}}
                    <i class="fa-solid fa-square-check text-success"></i>
                {{else}}
                    {{#if globalAnubis}}
                        <i class="fa-solid fa-square-minus text-{{#if anubis}}success{{else}}yellow{{/if}}"></i> (Enabled Globally)
                    {{else}}
                        <i class="fa-solid fa-square-xmark text-danger"></i>
                    {{/if}}
                {{/if}}<br>
                Target: <a href="{{target}}" target="_blank">{{target}}</a><br>
                {{!-- Redirect Only Mode: {{#if redirect}}<i class="fa-solid fa-square-check text-success"></i>{{else}}<i class="fa-solid fa-square-xmark text-danger"></i>{{/if}}<br>
                Temporary Redirect: {{#if redirectTemp}}<i class="fa-solid fa-square-check text-success"></i>{{else}}<i class="fa-solid fa-square-xmark text-danger"></i>{{/if}}<br> --}}
                Timeout: <b>{{timeout}}ms</b><br>
                HTTPS: {{#if acmebypass}}<i class="fa-solid fa-square-minus text-yellow"></i> (ACME Bypassed){{else}}{{#if secure}}<i class="fa-solid fa-square-check text-success"></i>{{else}}<i class="fa-solid fa-square-xmark text-danger"></i>{{/if}}{{/if}}<br>
                Auth Required: {{#if auth.enabled}}<i class="fa-solid fa-square-check text-success"></i>{{else}}<i class="fa-solid fa-square-xmark text-danger"></i>{{/if}}<br>
                Custom Headers: {{#if headers}}<i class="fa-solid fa-square-check text-success"></i>{{else}}<i class="fa-solid fa-square-xmark text-danger"></i>{{/if}}<br>
                </p>
                <p class="card-text">Description: {{description}}</p>

                {{#if acmebypass}}
                <p class="text-warning">ACME Bypassed, you can only manually edit this entry via <a href="/config" class="text-warning">config editor.</a></p>
                {{/if}}

                {{!-- Hide buttons when disabled --}}
                {{!-- {{#unless write_protected}}<a href="/proxy/{{id}}/edit" class="btn btn-primary">Edit</a>{{/unless}} --}}
                {{!-- <a href="/proxy/{{id}}/toggle/maintenance" class="btn btn-info disabled" disabled>Toggle Maintenance</a> --}}
                {{!-- {{#unless write_protected}}<a href="/proxy/{{id}}/toggle" class="btn btn-warning">Toggle</a>{{/unless}} --}}
                {{!-- {{#unless special}}
                    {{#unless write_protected}}
                        <a href="#" onclick="deleteItem('{{id}}', event)" class="btn btn-danger">Delete</a>
                    {{/unless}}
                {{/unless}} --}}

                {{!-- Disable buttons when disabled --}}
                <a href="/proxy/{{id}}/edit" class="btn btn-primary{{#if write_protected}} disabled{{/if}}{{#if acmebypass}} disabled{{/if}}"{{#if write_protected}}disabled{{/if}}{{#if acmebypass}}disabled{{/if}}>Edit</a>
                <a href="/proxy/{{id}}/toggle/maintenance" class="btn btn-info">Toggle Maintenance</a>
                <a href="/proxy/{{id}}/toggle" class="btn btn-warning{{#if write_protected}} disabled{{/if}}" {{#if write_protected}}disabled{{/if}}>Toggle</a>
                <a href="#" onclick="deleteItem('{{id}}', event)" class="btn btn-danger{{#if write_protected}} disabled{{/if}}{{#if special}} disabled{{/if}}" {{#if write_protected}}disabled{{/if}}{{#if special}}disabled{{/if}}>Delete</a>
                
                <script>
                function deleteItem(id, event) {
                    event.preventDefault();
                    if (confirm('Are you sure you want to delete this proxy?')) {
                        fetch('/proxy/' + id + '/delete', { method: 'POST' })
                            .then(() => window.location.reload());
                    }
                }
                </script>
            </div>
        </div>
    {{/each}}
    </div>
</div>