<h1 class="text-center">Status Pages / Stubs</h1>
<p>Note: Stubs take precedence over Proxies. If a Stub is configured and enabled for a domain, the Proxy will not be used.</p>
<div class="row">
    <div class="col">
    <a href="/stub/new" class="btn btn-primary">New Stub</a>
    <a href="#" onclick="applyConfig(event)" class="btn btn-info">Apply Config</a>
    <p class="spacer"></p>
    {{#each stubs}}
        <div class="card">
            <div class="card-body">
                {{#unless write_protected}}
                    <a href="/stub/{{id}}/toggle" title="Toggle Enabled" style="text-decoration:none;">
                        {{#if enabled}}
                            <i class="fas fa-check-circle mr-1 text-success" title="Enabled"></i>
                        {{else}}
                            <i class="fas fa-circle-xmark mr-1 text-danger" title="Disabled"></i>
                        {{/if}}
                    </a>
                {{else}}
                    {{#if enabled}}
                        <i class="fas fa-check-circle mr-1 text-success" title="Enabled"></i>
                    {{else}}
                        <i class="fas fa-circle-xmark mr-1 text-danger" title="Disabled"></i>
                    {{/if}}
                {{/unless}}
                {{#if write_protected}}
                    <a href="/stub/{{id}}/toggle/protection" class="text-danger" title="Write Protected (click to unlock)" style="text-decoration:none;">
                        <i class="fa fa-lock mr-1"></i>
                    </a>
                {{else}}
                    <a href="/stub/{{id}}/toggle/protection" class="text-success" title="Not Protected (click to lock)" style="text-decoration:none;">
                        <i class="fa fa-unlock mr-1"></i>
                    </a>
                {{/if}}
                {{#if special}}<i class="fa fa-star mr-1 text-warning" title="System Rule"></i>{{/if}}
                <h5 class="card-title">
                    {{#each host}}
                        <a href="{{#if ../secure}}https://{{else}}http://{{/if}}{{this}}" target="_blank">{{this}}</a>{{#unless @last}}, {{/unless}}
                    {{/each}}
                </h5>
                <p class="card-text">
                Enabled: {{#if enabled}}<i class="fa-solid fa-square-check text-success"></i>{{else}}<i class="fa-solid fa-square-xmark text-danger"></i>{{/if}}<br>
                Status Code: <b>{{status}}</b> ({{status_message}})<br>
                Message: "{{#if message}}{{message}}{{else}}{{status_message}}{{/if}}"<br>
                HTTPS: {{#if secure}}<i class="fa-solid fa-square-check text-success"></i>{{else}}<i class="fa-solid fa-square-xmark text-danger"></i>{{/if}}<br>
                </p>
                <p class="card-text">Description: {{description}}</p>
                {{!-- {{#unless write_protected}}<a href="/stub/{{id}}/edit" class="btn btn-primary">Edit</a>{{/unless}}
                {{#unless write_protected}}<a href="/stub/{{id}}/toggle" class="btn btn-warning">Toggle</a>{{/unless}}
                {{#unless special}}
                    {{#unless write_protected}}
                        <a href="#" onclick="deleteItem('{{id}}', event)" class="btn btn-danger">Delete</a>
                    {{/unless}}
                {{/unless}} --}}
                <a href="/stub/{{id}}/edit" class="btn btn-primary{{#if write_protected}} disabled{{/if}}" {{#if write_protected}}disabled{{/if}}>Edit</a>
                <a href="/stub/{{id}}/toggle" class="btn btn-warning{{#if write_protected}} disabled{{/if}}" {{#if write_protected}}disabled{{/if}}>Toggle</a>
                <a href="#" onclick="deleteItem('{{id}}', event)" class="btn btn-danger{{#if write_protected}} disabled{{/if}}{{#if special}} disabled{{/if}}" {{#if write_protected}}disabled{{/if}}{{#if special}}disabled{{/if}}>Delete</a>
                <script>
                function deleteItem(id, event) {
                    event.preventDefault();
                    if (confirm('Are you sure you want to delete this stub?')) {
                        fetch('/stub/' + id + '/delete', { method: 'POST' })
                            .then(() => window.location.reload());
                    }
                }
                </script>
            </div>
        </div>
    {{/each}}
    </div>
</div>