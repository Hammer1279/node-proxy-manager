<h1 class="text-center">Edit: Configuration</h1>
<h3 class="text-warning text-center">Entering a Invalid Config can make this inaccessible and require direct modification.<br>Use caution and double check changes. Only JSON Schema validation is done.</h3>
<div style="width:100vw;max-width:100vw;margin-left:calc(-50vw + 50%);margin-right:calc(-50vw + 50%);">
    <form id="configForm" class="needs-validation" method="POST" novalidate>
        <div class="mb-3">
            <label for="config" class="form-label">Config Code</label>
            <!-- Hidden textarea for form submission -->
            <textarea class="form-control d-none" id="config" name="config"></textarea>
            <!-- Ace Editor container -->
            <div id="ace-editor" style="height: 60vh; min-height: 300px; width: 99.9vw;">{{config}}</div>
        </div>
        <button type="submit" class="btn btn-primary" style="width:auto;">Save Configuration</button>
    </form>
</div>
<!-- Ace Editor CDN -->
<script src="https://cdn.jsdelivr.net/npm/ace-builds@1.43.2/src-min-noconflict/ace.js"></script>
<script>
// JavaScript for form validation
(function () {
    'use strict'
    var forms = document.querySelectorAll('.needs-validation')
    Array.prototype.slice.call(forms).forEach(function (form) {
        form.addEventListener('submit', function (event) {
            // Update textarea with Ace Editor content before submit
            var aceEditor = ace.edit("ace-editor");
            document.getElementById('config').value = aceEditor.getValue();

            if (!form.checkValidity()) {
                event.preventDefault()
                event.stopPropagation()
            }
            form.classList.add('was-validated')
        }, false)
    })

    // Initialize Ace Editor
    var editor = ace.edit("ace-editor");
    editor.setTheme("ace/theme/monokai");
    editor.session.setMode("ace/mode/json");
    editor.setOptions({
        fontSize: "14px",
        showPrintMargin: false
    });
})();

document.getElementById('configForm').addEventListener('submit', function(event) {
    event.preventDefault();

    // Get config from Ace Editor
    var aceEditor = ace.edit("ace-editor");
    var configValue = aceEditor.getValue();

    // First POST: Save config
    fetch('/config/edit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ config: configValue })
    })
    .then(response => {
        if (!response.ok) throw new Error('Save failed');
        // Second POST: Apply config
        return fetch('/config/apply', { method: 'POST' });
    })
    .then(response => {
        if (!response.ok) throw new Error('Apply failed');
        // Optionally redirect or show a message
        window.location.href = '/config'; // or show a success message
    })
    .catch(err => {
        alert('Error: ' + err.message);
    });
});
</script>